# === GoTani Lead Agent — Environment Variables ===

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Budget & Rate Limit LLM ---
LLM_DAILY_BUDGET_USD=0.50
LLM_MAX_REQUESTS_PER_DAY=800
LLM_MIN_SECONDS_BETWEEN_CALLS=4.0
LLM_BATCH_SIZE=15

# --- Harga Token (USD per 1 juta token) ---
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.40

# --- Ambang Lead Valid (PRD §3.3) ---
RELEVANCE_MIN=70
CONFIDENCE_MIN=60

# --- Facebook Rate Limit (F2.4) ---
FB_SECONDS_BETWEEN_PAGES=20
FB_MAX_PAGES_PER_HOUR=60
FB_MAX_PAGES_PER_DAY=300
FB_SETTLE_MS=4000
FB_RESCAN_HOURS=12

# --- Path ---
DB_PATH=data/gotani.db
